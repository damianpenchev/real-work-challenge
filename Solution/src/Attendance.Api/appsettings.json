{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=attendance.db"
  },
  "Attendance": {
    "DefaultPresentCode": "P",
    "MaxBatchSize": 500,
    "AllowFutureDates": false,
    "DefaultAbsenceThreshold": 10,
    "AbsenteeismPolicy": "AbsenceCount"
  }
}
